# Copy to .env and fill in. The .env file is gitignored and read ONLY on the server
# side (the /api/coach proxy). Do NOT prefix with VITE_ — that would expose it to the
# browser bundle.

# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Coach models, tried in order until one responds (free endpoints often rate-limit).
COACH_MODELS=google/gemma-4-31b-it:free,openai/gpt-oss-120b:free,meta-llama/llama-3.3-70b-instruct:free

# Online "play a friend": the deployed Cloudflare Worker host (from `wrangler deploy`),
# e.g. chronael-chess.<you>.workers.dev. This one IS a VITE_ var on purpose — it's just
# a host name, safe to expose. In dev it defaults to 127.0.0.1:8787 (run `wrangler dev`),
# so you can leave it blank.
VITE_GAME_HOST=

# Shared secret between the coach proxy (Vercel) and the game Worker's /ratelimit
# endpoint, so the coach rate limit is global across every serverless instance.
# Set the SAME value in both places:
#   npx wrangler secret put RL_SECRET        (Cloudflare)
#   npx vercel env add RL_SECRET production  (Vercel)
# Locally, put it in web-app/.dev.vars for `wrangler dev`. If unset, the coach falls
# back to a per-instance in-memory limit.
RL_SECRET=

# Host of the game Worker used by the SERVER-side coach proxy for rate limiting.
# Optional: falls back to VITE_GAME_HOST.
GAME_HOST=
